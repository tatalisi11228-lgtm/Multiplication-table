{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      // integratedTerminal is REQUIRED for input() to work.
      // The default internal console cannot accept keyboard input.
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
