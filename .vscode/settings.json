{
  // Points VS Code at the REAL Python 3.14.3 interpreter.
  // Without this, VS Code may pick up the broken Microsoft Store stub in WindowsApps.
  "python.defaultInterpreterPath": "C:\\Users\\Hamid\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe",

  // 4 spaces per indent — the Python standard (PEP 8).
  "editor.tabSize": 4,
  "editor.insertSpaces": true,

  // A soft line at 80 characters; keeps lines readable.
  "editor.rulers": [79],

  // Pylance checks your code as you type and underlines mistakes BEFORE you run it.
  "python.analysis.typeCheckingMode": "basic",

  // Save behaviour
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": false
}
